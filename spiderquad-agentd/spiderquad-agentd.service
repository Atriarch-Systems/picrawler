[Unit]
Description=spiderquad-agentd (PiCrawler control/sense API for Virali)
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=dp_admin
Group=dp_admin
SupplementaryGroups=gpio i2c spi audio video
WorkingDirectory=/home/dp_admin/picrawler/spiderquad-agentd
Environment=SQ_PORT=8970
ExecStart=/usr/bin/python3 /home/dp_admin/picrawler/spiderquad-agentd/agentd.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
